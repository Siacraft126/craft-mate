import React, { useState } from 'react';

export default function App() {
  const [client, setClient] = useState('');
  const [colors, setColors] = useState('');
  const [materials, setMaterials] = useState('');
  const [notes, setNotes] = useState('');
  const [records, setRecords] = useState([]);

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!client && !colors && !materials) return;

    const newRecord = {
      id: Date.now(),
      client: client || 'Nenorādīts objekts / klients',
      colors: colors || 'Nav norādīts',
      materials: materials || 'Nav norādīts',
      notes: notes || '',
      date: new Date().toLocaleDateString('lv-LV')
    };

    setRecords([newRecord, ...records]);
    setClient('');
    setColors('');
    setMaterials('');
    setNotes('');
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '600px', margin: '0 auto', backgroundColor: '#0f172a', color: '#fff', borderRadius: '12px', border: '1px solid #334155' }}>
      <h1 style={{ fontSize: '20px', marginBottom: '15px' }}>AS CRAFT | Materiālu un Krāsu Uzskaite</h1>
      
      <form onSubmit={handleSubmit} style={{ border: '1px solid #475569', padding: '15px', borderRadius: '8px', marginBottom: '15px', backgroundColor: '#1e293b' }}>
        <div style={{ marginBottom: '12px' }}>
          <label style={{ display: 'block', marginBottom: '5px', fontSize: '13px', color: '#94a3b8' }}>Klienta vārds / Objekta nosaukums:</label>
          <input 
            type="text" 
            value={client} 
            onChange={(e) => setClient(e.target.value)} 
            placeholder="Piem., Taņa / Brekšu iela" 
            style={{ width: '100%', padding: '8px', borderRadius: '6px', backgroundColor: '#0f172a', border: '1px solid #475569', color: '#fff', boxSizing: 'border-box' }}
          />
        </div>

        <div style={{ marginBottom: '12px' }}>
          <label style={{ display: 'block', marginBottom: '5px', fontSize: '13px', color: '#94a3b8' }}>Krāsas un toņi (kodi):</label>
          <input 
            type="text" 
            value={colors} 
            onChange={(e) => setColors(e.target.value)} 
            placeholder="Piem., RAL 7016, Smoked oak eļļa" 
            style={{ width: '100%', padding: '8px', borderRadius: '6px', backgroundColor: '#0f172a', border: '1px solid #475569', color: '#fff', boxSizing: 'border-box' }}
          />
        </div>

        <div style={{ marginBottom: '12px' }}>
          <label style={{ display: 'block', marginBottom: '5px', fontSize: '13px', color: '#94a3b8' }}>Izlietotie materiāli:</label>
          <input 
            type="text" 
            value={materials} 
            onChange={(e) => setMaterials(e.target.value)} 
            placeholder="Piem., Boen ozola parkets 25m², V33 eļļa 2L" 
            style={{ width: '100%', padding: '8px', borderRadius: '6px', backgroundColor: '#0f172a', border: '1px solid #475569', color: '#fff', boxSizing: 'border-box' }}
          />
        </div>

        <div style={{ marginBottom: '15px' }}>
          <label style={{ display: 'block', marginBottom: '5px', fontSize: '13px', color: '#94a3b8' }}>Papildu piezīmes / darbi:</label>
          <textarea 
            value={notes} 
            onChange={(e) => setNotes(e.target.value)} 
            placeholder="Montāžas nianses, papildu detaļas..." 
            rows="2"
            style={{ width: '100%', padding: '8px', borderRadius: '6px', backgroundColor: '#0f172a', border: '1px solid #475569', color: '#fff', boxSizing: 'border-box', resize: 'vertical' }}
          />
        </div>

        <button 
          type="submit" 
          style={{ width: '100%', padding: '10px', backgroundColor: '#3b82f6', color: '#fff', border: 'none', borderRadius: '6px', fontWeight: 'bold', cursor: 'pointer' }}
        >
          Saglabāt ierakstu sarakstā
        </button>
      </form>

      {records.length > 0 && (
        <div style={{ backgroundColor: '#1e293b', padding: '15px', borderRadius: '8px', border: '1px solid #334155' }}>
          <h3 style={{ fontSize: '16px', margin: '0 0 10px 0', color: '#34d399' }}>Saglabātie objekti un materiāli:</h3>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
            {records.map((item) => (
              <div key={item.id} style={{ backgroundColor: '#0f172a', padding: '12px', borderRadius: '6px', border: '1px solid #334155' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '14px', fontWeight: 'bold', color: '#38bdf8', marginBottom: '6px' }}>
                  <span>📍 {item.client}</span>
                  <span style={{ fontSize: '12px', color: '#94a3b8' }}>{item.date}</span>
                </div>
                <div style={{ fontSize: '13px', color: '#facc15', marginBottom: '4px' }}>
                  🎨 <b>Krāsas / Kods:</b> {item.colors}
                </div>
                <div style={{ fontSize: '13px', color: '#34d399', marginBottom: '4px' }}>
                  🧱 <b>Materiāli:</b> {item.materials}
                </div>
                {item.notes && (
                  <div style={{ fontSize: '13px', color: '#cbd5e1', marginTop: '4px', fontStyle: 'italic' }}>
                    💬 {item.notes}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
