<!DOCTYPE html>
<html lang="lv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Craft-Mate | Tāmju Kalkulators</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; max-width: 600px; background-color: #f4f4f9; }
        .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        h2 { color: #333; }
        label { display: block; margin-top: 10px; font-weight: bold; }
        input, select { width: 100%; padding: 8px; margin-top: 5px; box-sizing: border-box; }
        button { margin-top: 15px; padding: 10px 15px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px; }
        .result { margin-top: 20px; font-size: 18px; font-weight: bold; color: #0056b3; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Craft-Mate Tāmes Aprēķins</h2>
        
        <label for="service">Pakalpojuma veids:</label>
        <select id="service">
            <option value="50">Koka karkasa darbi (€50/m²)</option>
            <option value="12">Estrich grīdu ieklāšana (€12/m²)</option>
            <option value="30">Santehnikas darbi (bāze €30/st)</option>
            <option value="40">Apdare un interjers (€40/m²)</option>
        </select>

        <label for="amount">Apmērs (m² vai stundas):</label>
        <input type="number" id="amount" placeholder="Ievadiet daudzumu" value="1">

        <button onclick="calculate()">Aprēķināt tāmi</button>

        <div class="result" id="totalResult">Kopā: €0.00</div>
    </div>

    <script>
        function calculate() {
            const price = parseFloat(document.getElementById('service').value);
            const amount = parseFloat(document.getElementById('amount').value) || 0;
            const total = price * amount;
            document.getElementById('totalResult').innerText = "Aptuvenā tāme: €" + total.toFixed(2);
        }
    </script>
</body>
</html>
