import React, { useState } from 'react';
import { createClient } from '@supabase/supabase-js';

// Supabase konfigurācija
const SUPABASE_URL = 'https://amber-coin.supabase.co';
const SUPABASE_KEY = 'sb_publishable__Vkj57vXYe1DrJFIOKNJLA_jDGroKU7';
const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

export default function App() {
  const [file, setFile] = useState(null);
  const [uploading, setUploading] = useState(false);
  const [uploadedUrl, setUploadedUrl] = useState('');
  const [errorMsg, setErrorMsg] = useState('');

  const handleFileChange = (e) => {
    if (e.target.files && e.target.files[0]) {
      setFile(e.target.files[0]);
      setErrorMsg('');
    }
  };

  const handleUpload = async () => {
    if (!file) {
      setErrorMsg('Lūdzu, izvēlieties failu!');
      return;
    }

    try {
      setUploading(true);
      setErrorMsg('');

      // Unikāls faila nosaukums
      const fileExt = file.name.split('.').pop();
      const fileName = `${Date.now()}.${fileExt}`;
      const filePath = `${fileName}`;

      // Augšupielāde uz craftmate-files krātuvi
      const { data, error } = await supabase.storage
        .from('craftmate-files')
        .upload(filePath, file);

      if (error) {
        throw error;
      }

      // Publiskās saites iegūšana
      const { data: publicUrlData } = supabase.storage
        .from('craftmate-files')
        .getPublicUrl(filePath);

      setUploadedUrl(publicUrlData.publicUrl);
    } catch (err) {
      console.error('Kļūda augšupielādējot:', err);
      setErrorMsg('Kļūda augšupielādējot failu: ' + err.message);
    } finally {
      setUploading(false);
    }
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '500px', margin: '0 auto' }}>
      <h1>CraftMate - Failu augšupielāde</h1>
      
      <div style={{ border: '1px solid #ccc', padding: '15px', borderRadius: '8px', marginBottom: '15px' }}>
        <input type="file" onChange={handleFileChange} disabled={uploading} />
        <button 
          onClick={handleUpload} 
          disabled={uploading}
          style={{
            marginTop: '10px',
            padding: '8px 16px',
            backgroundColor: uploading ? '#ccc' : '#0070f3',
            color: 'white',
            border: 'none',
            borderRadius: '4px',
            cursor: uploading ? 'not-allowed' : 'pointer'
          }}
        >
          {uploading ? 'Augšupielādē...' : 'Augšupielādēt failu'}
        </button>
      </div>

      {errorMsg && (
        <p style={{ color: 'red' }}>{errorMsg}</p>
      )}

      {uploadedUrl && (
        <div style={{ marginTop: '15px', wordBreak: 'break-all' }}>
          <p style={{ color: 'green', fontWeight: 'bold' }}>Fails veiksmīgi augšupielādēts!</p>
          <p>Saite uz failu:</p>
          <a href={uploadedUrl} target="_blank" rel="noopener noreferrer">
            {uploadedUrl}
          </a>
        </div>
      )}
    </div>
  );
}
