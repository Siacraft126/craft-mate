<!DOCTYPE html>
<html lang="lv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Craft-Mate | Tāmju Kalkulators</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    body { font-family: Arial, sans-serif; background: #0f172a; color: #fff; padding: 20px; }
    .card { background: #1e293b; padding: 20px; border-radius: 12px; max-width: 500px; margin: 0 auto 20px auto; }
    h2 { color: #f8fafc; margin-top: 0; }
    label { display: block; margin-top: 10px; font-size: 14px; }
    input, select { width: 100%; padding: 10px; margin-top: 5px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: #fff; box-sizing: border-box; }
    button { margin-top: 15px; padding: 12px; width: 100%; background: #2563eb; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
    button:disabled { opacity: 0.6; }
    .status { margin-top: 10px; font-size: 13px; color: #facc15; }
  </style>
</head>
<body>

  <div class="card">
    <h2>Craft-Mate Tāmes Aprēķins</h2>
    <label for="service">Pakalpojuma veids:</label>
    <select id="service">
      <option value="50">Koka karkasa darbi (50 €/m²)</option>
      <option value="40">Apdare un interjers (40 €/m²)</option>
      <option value="35">Santehnika un komunikācijas (35 €/m²)</option>
    </select>

    <label for="area">Platība (m²):</label>
    <input type="number" id="area" placeholder="Ievadiet m²" value="10">

    <button onclick="calculate()">Aprēķināt tāmi</button>
    <h3 id="result" style="margin-top: 15px;"></h3>
  </div>

  <div class="card">
    <h2>Pievienot dokumentu vai foto</h2>
    <input type="file" id="fileInput">
    <button id="uploadBtn" onclick="uploadFile()">Augšupielādēt uz Supabase</button>
    <div id="uploadStatus" class="status"></div>
  </div>

  <script>
    function calculate() {
      const price = parseFloat(document.getElementById('service').value);
      const area = parseFloat(document.getElementById('area').value) || 0;
      document.getElementById('result').innerText = 'Kopā: ' + (price * area) + ' €';
    }

    const SUPABASE_URL = 'https://YOUR_SUPABASE_URL.supabase.co'; 
    const SUPABASE_KEY = 'YOUR_SUPABASE_ANON_KEY';
    
    const _supabase = window.supabase ? window.supabase.createClient(
      window.ENV_SUPABASE_URL || SUPABASE_URL,
      window.ENV_SUPABASE_KEY || SUPABASE_KEY
    ) : null;

    async function uploadFile() {
      const fileInput = document.getElementById('fileInput');
      const status = document.getElementById('uploadStatus');
      const file = fileInput.files[0];

      if (!file) {
        alert('Lūdzu, izvēlieties failu!');
        return;
      }

      if (!_supabase) {
        alert('Supabase klients nav konfigurēts!');
        return;
      }

      status.innerText = 'Notiek augšupielāde...';
      const fileName = Date.now() + '-' + file.name;

      const { data, error } = await _supabase.storage
        .from('craftmate-files')
        .upload('uploads/' + fileName, file);

      if (error) {
        status.innerText = 'Kļūda: ' + error.message;
      } else {
        status.innerText = 'Fails veiksmīgi augšupielādēts!';
        alert('Fails saglabāts mākonī!');
      }
    }
  </script>
</body>
</html>
